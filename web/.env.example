# Microsoft Clarity (production only)
NEXT_PUBLIC_CLARITY_ID=

# PostHog
VITE_PUBLIC_POSTHOG_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=

# Express API origin used in production builds, e.g. https://api.teamgodevs.in
# Leave empty in local dev — Vite proxies /api to VITE_API_PROXY_TARGET.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:5050

# Razorpay public key id only (never the secret — that lives in api/.env)
VITE_RAZORPAY_KEY_ID=

# Student / College projects catalog (menu + home section + /student-projects page)
# Set to true to show it. Build-time flag — redeploy after changing on Vercel.
VITE_IS_COLLEGE_PROJECT=false
