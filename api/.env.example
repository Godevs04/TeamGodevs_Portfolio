NODE_ENV=development
PORT=5050
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:8080,http://localhost:4173,https://www.teamgodevs.in
# Number of reverse proxies in front of the API (Render / Railway / Nginx = 1)
TRUST_PROXY=1

# MongoDB Atlas (Atlas → Connect → Drivers). API runs without persistence when empty.
MONGODB_URI=
MONGODB_DB_NAME=teamgodevs

# Razorpay — server-side only, never expose KEY_SECRET to the frontend
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Settings → Webhooks → secret for POST /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Upper limit for custom-amount payments (INR)
PAYMENT_MAX_AMOUNT_INR=500000

# Resend
RESEND_API_KEY=
EMAIL_PERSONS=hello@teamgodevs.in
RESEND_FROM_EMAIL=TeamGoDevs <hello@teamgodevs.in>

# Contact form rate limits (defaults: 3/hour, 10/day per IP)
CONTACT_RATE_LIMIT_HOUR=3
CONTACT_RATE_LIMIT_DAY=10

# Local dev only: simulate visitor country for geo pricing (IN, US, GB, ID, etc.)
DEV_VIEWER_COUNTRY=
