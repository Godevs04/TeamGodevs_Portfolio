# Microsoft Clarity (production only)
NEXT_PUBLIC_CLARITY_ID=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Recommended for production (Supabase → Settings → API → service_role)
# Server falls back to VITE_SUPABASE_PUBLISHABLE_KEY if this is empty
SUPABASE_SERVICE_ROLE_KEY=

# Resend — server-side only (never prefix with VITE_)
RESEND_API_KEY=
EMAIL_PERSONS=hello@teamgodevs.in
RESEND_FROM_EMAIL=TeamGoDevs <hello@teamgodevs.in>

# Contact form rate limits (optional — defaults: 3/hour, 10/day per IP)
CONTACT_RATE_LIMIT_HOUR=3
CONTACT_RATE_LIMIT_DAY=10
